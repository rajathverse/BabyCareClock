    "Due every day at these times, even if one was given a little early or late." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো ডোজ একটু আগে বা পরে দিলেও, রোজ এই সময়গুলোতেই।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due every day at these times, even if one was given a little early or late."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ ડોઝ થોડો વહેલો કે મોડો આપ્યો હોય તો પણ, રોજ આ જ સમયે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर दिन इन्हीं समय पर, भले कोई खुराक थोड़ा पहले या बाद में दी गई हो।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದು ಡೋಸ್ ಸ್ವಲ್ಪ ಬೇಗ ಅಥವಾ ತಡವಾಗಿ ಕೊಟ್ಟರೂ, ಪ್ರತಿದಿನ ಇದೇ ಸಮಯಗಳಲ್ಲಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു ഡോസ് അൽപം നേരത്തെയോ വൈകിയോ നൽകിയാലും, ദിവസവും ഇതേ സമയങ്ങളിൽ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एखादा डोस थोडा लवकर किंवा उशिरा दिला तरी, दररोज याच वेळी."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କୌଣସି ଡୋଜ୍ ଟିକେ ଆଗରୁ କିମ୍ବା ପରେ ଦେଲେ ବି, ପ୍ରତିଦିନ ଏହି ସମୟରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਭਾਵੇਂ ਕੋਈ ਖ਼ੁਰਾਕ ਥੋੜ੍ਹੀ ਪਹਿਲਾਂ ਜਾਂ ਬਾਅਦ ਦਿੱਤੀ ਹੋਵੇ, ਹਰ ਰੋਜ਼ ਇਨ੍ਹਾਂ ਹੀ ਸਮਿਆਂ 'ਤੇ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு அளவு சற்று முன்போ பின்போ கொடுக்கப்பட்டாலும், தினமும் இதே நேரங்களில்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక మోతాదు కొంచెం ముందు లేదా ఆలస్యంగా ఇచ్చినా, ప్రతిరోజూ ఇవే సమయాల్లో."
          }
        }
      }
    },
