        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಕೊನೆಯ ಬಾರಿ ಆದ ನಂತರ ಇಷ್ಟು ಸಮಯಕ್ಕೆ ಮುಂದಿನದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവസാനം കഴിഞ്ഞതിന് ശേഷം ഇത്ര സമയം കഴിഞ്ഞ് അടുത്തത്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेवटच्या वेळेनंतर इतक्या वेळाने पुढचे."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶେଷଥର ପରେ ଏତିକି ସମୟରେ ପରବର୍ତ୍ତୀ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਿਛਲੀ ਵਾਰ ਤੋਂ ਬਾਅਦ ਇੰਨੇ ਸਮੇਂ 'ਤੇ ਅਗਲਾ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசியாக முடிந்த பிறகு இவ்வளவு நேரத்தில் அடுத்தது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చివరిసారి అయిన తర్వాత ఇంత సమయానికి తర్వాతది."
          }
        }
      }
    },
