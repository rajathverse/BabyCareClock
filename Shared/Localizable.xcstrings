    "For things like fever medicine. No reminders. Today shows when it's OK to give again. Use the gap your doctor or the label gives." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জ্বরের ওষুধের মতো জিনিসের জন্য। কোনো রিমাইন্ডার নেই। আবার কখন দেওয়া যাবে \"আজ\" এ দেখা যাবে। ডাক্তার বা লেবেলের বলা ব্যবধান মেনে চলুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For things like fever medicine. No reminders. Today shows when it's OK to give again. Use the gap your doctor or the label gives."
