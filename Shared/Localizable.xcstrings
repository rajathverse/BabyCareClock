{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is already in your care plan. Edit the existing one instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" আগে থেকেই আপনার যত্নের পরিকল্পনায় আছে। নতুন যোগ না করে সেটাই বদলান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is already in your care plan. Edit the existing one instead."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" પહેલેથી તમારી સંભાળ યોજનામાં છે. નવું ઉમેરવાને બદલે તે જ બદલો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" पहले से आपकी देखभाल योजना में है। नया जोड़ने के बजाय उसी को बदलें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ಈಗಾಗಲೇ ನಿಮ್ಮ ಆರೈಕೆ ಯೋಜನೆಯಲ್ಲಿದೆ. ಹೊಸದನ್ನು ಸೇರಿಸುವ ಬದಲು ಅದನ್ನೇ ಬದಲಿಸಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ഇതിനകം നിങ്ങളുടെ പരിചരണ പദ്ധതിയിലുണ്ട്. പുതിയത് ചേർക്കുന്നതിന് പകരം അത് മാറ്റുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" आधीच तुमच्या काळजी योजनेत आहे. नवीन जोडण्याऐवजी तेच बदला."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ପୂର୍ବରୁ ଆପଣଙ୍କ ଯତ୍ନ ଯୋଜନାରେ ଅଛି। ନୂଆ ଯୋଡ଼ିବା ବଦଳରେ ସେଇଟିକୁ ବଦଳାନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ਪਹਿਲਾਂ ਹੀ ਤੁਹਾਡੀ ਦੇਖਭਾਲ ਯੋਜਨਾ ਵਿੱਚ ਹੈ। ਨਵਾਂ ਜੋੜਨ ਦੀ ਬਜਾਏ ਉਹੀ ਬਦਲੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ஏற்கனவே உங்கள் பராமரிப்புத் திட்டத்தில் உள்ளது. புதிதாகச் சேர்க்காமல் அதையே மாற்றுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ఇప్పటికే మీ సంరక్షణ ప్రణాళికలో ఉంది. కొత్తది జోడించకుండా దాన్నే మార్చండి."
          }
        }
      }
    },
