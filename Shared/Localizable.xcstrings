    "Its reminders and history will be removed too." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর রিমাইন্ডার আর রেকর্ডও মুছে যাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its reminders and history will be removed too."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તેના રિમાઇન્ડર અને રેકોર્ડ પણ કાઢી નખાશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके रिमाइंडर और रिकॉर्ड भी हट जाएँगे।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದರ ಜ್ಞಾಪನೆಗಳು ಮತ್ತು ದಾಖಲೆಯೂ ಅಳಿಸಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇതിന്റെ ഓർമ്മപ്പെടുത്തലുകളും രേഖയും നീക്കം ചെയ്യും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "याच्या आठवणी आणि नोंदीही काढल्या जातील."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହାର ସ୍ମାରକ ଓ ରେକର୍ଡ ମଧ୍ୟ ହଟିଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਦੀਆਂ ਯਾਦ-ਦਹਾਨੀਆਂ ਅਤੇ ਰਿਕਾਰਡ ਵੀ ਹਟ ਜਾਣਗੇ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இதன் நினைவூட்டல்களும் பதிவும் நீக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దీని రిమైండర్లు మరియు రికార్డు కూడా తొలగించబడతాయి."
          }
        }
      }
    },
