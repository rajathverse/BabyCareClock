    "No vaccine names were found. Try again in good light, or enter them manually." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো টিকার নাম পাওয়া যায়নি। ভালো আলোয় আবার চেষ্টা করুন, বা নিজে লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vaccine names were found. Try again in good light, or enter them manually."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈ રસીનું નામ મળ્યું નહીં. સારા પ્રકાશમાં ફરી પ્રયાસ કરો, અથવા જાતે લખો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई टीके का नाम नहीं मिला। अच्छी रोशनी में फिर कोशिश करें, या ख़ुद लिखें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಯಾವುದೇ ಲಸಿಕೆಯ ಹೆಸರು ಸಿಗಲಿಲ್ಲ. ಒಳ್ಳೆಯ ಬೆಳಕಿನಲ್ಲಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ನೀವೇ ಬರೆಯಿರಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വാക്സിൻ പേരുകളൊന്നും കണ്ടെത്തിയില്ല. നല്ല വെളിച്ചത്തിൽ വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ സ്വയം എഴുതുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लसीचे कोणतेही नाव सापडले नाही. चांगल्या उजेडात पुन्हा प्रयत्न करा, किंवा स्वतः लिहा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କୌଣସି ଟିକାର ନାମ ମିଳିଲା ନାହିଁ। ଭଲ ଆଲୋକରେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ, କିମ୍ବା ନିଜେ ଲେଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਟੀਕੇ ਦਾ ਨਾਮ ਨਹੀਂ ਮਿਲਿਆ। ਚੰਗੀ ਰੋਸ਼ਨੀ ਵਿੱਚ ਫਿਰ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਖ਼ੁਦ ਲਿਖੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தடுப்பூசிப் பெயர் எதுவும் கிடைக்கவில்லை. நல்ல வெளிச்சத்தில் மீண்டும் முயலுங்கள், அல்லது நீங்களே எழுதுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "టీకా పేర్లు ఏవీ కనబడలేదు. మంచి వెలుతురులో మళ్లీ ప్రయత్నించండి, లేదా మీరే రాయండి."
          }
        }
      }
    },
