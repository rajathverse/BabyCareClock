    "Last given %@ ago. The minimum gap is %@, so wait until %@ unless your doctor says otherwise." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষবার %1$@ আগে দেওয়া হয়েছে। ন্যূনতম ব্যবধান %2$@, তাই ডাক্তার অন্য কিছু না বললে %3$@ পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last given %@ ago. The minimum gap is %@, so wait until %@ unless your doctor says otherwise."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "છેલ્લે %1$@ પહેલાં આપ્યું. ઓછામાં ઓછું અંતર %2$@ છે, તેથી ડૉક્ટર બીજું ન કહે ત્યાં સુધી %3$@ સુધી રાહ જુઓ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आख़िरी बार %1$@ पहले दिया। कम से कम %2$@ का अंतर ज़रूरी है, इसलिए %3$@ बजे तक रुकें, जब तक डॉक्टर कुछ और न कहें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಹಿಂದೆ ಕೊನೆಯ ಬಾರಿ ಕೊಡಲಾಗಿದೆ. ಕನಿಷ್ಠ ಅಂತರ %2$@, ಹಾಗಾಗಿ ವೈದ್ಯರು ಬೇರೆ ಹೇಳದ ಹೊರತು %3$@ ರವರೆಗೆ ಕಾಯಿರಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ മുമ്പ് അവസാനം നൽകി. കുറഞ്ഞ ഇടവേള %2$@ ആണ്, അതിനാൽ ഡോക്ടർ മറ്റൊന്ന് പറയുന്നില്ലെങ്കിൽ %3$@ വരെ കാത്തിരിക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेवटचे %1$@ आधी दिले. किमान अंतर %2$@ आहे, म्हणून डॉक्टरांनी वेगळे सांगितले नसेल तर %3$@ पर्यंत थांबा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶେଷଥର %1$@ ତଳେ ଦିଆଗଲା। ସର୍ବନିମ୍ନ ବ୍ୟବଧାନ %2$@, ତେଣୁ ଡାକ୍ତର ଅନ୍ୟ କିଛି ନ କହିଲେ %3$@ ପର୍ଯ୍ୟନ୍ତ ଅପେକ୍ଷା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਖ਼ਰੀ ਵਾਰ %1$@ ਪਹਿਲਾਂ ਦਿੱਤਾ। ਘੱਟੋ-ਘੱਟ ਫ਼ਰਕ %2$@ ਹੈ, ਇਸ ਲਈ ਜਦ ਤੱਕ ਡਾਕਟਰ ਕੁਝ ਹੋਰ ਨਾ ਕਹਿਣ, %3$@ ਤੱਕ ਰੁਕੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசியாக %1$@ முன்பு கொடுக்கப்பட்டது. குறைந்தபட்ச இடைவெளி %2$@, எனவே மருத்துவர் வேறு சொல்லாவிட்டால் %3$@ வரை காத்திருங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ క్రితం చివరిసారి ఇచ్చారు. కనీస వ్యవధి %2$@, కాబట్టి డాక్టర్ వేరేగా చెప్పకపోతే %3$@ వరకు ఆగండి."
          }
        }
      }
    },
