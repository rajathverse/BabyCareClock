            "value" : "নোটিফিকেশন বন্ধ। সেটিংসে চালু করুন"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off. Turn on in Settings"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સૂચનાઓ બંધ છે. સેટિંગ્સમાં ચાલુ કરો"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोटिफ़िकेशन बंद हैं। सेटिंग्स में चालू करें"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಧಿಸೂಚನೆಗಳು ಆಫ್ ಆಗಿವೆ. ಸೆಟ್ಟಿಂಗ್ಸ್‌ನಲ್ಲಿ ಆನ್ ಮಾಡಿ"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അറിയിപ്പുകൾ ഓഫാണ്. ക്രമീകരണങ്ങളിൽ ഓണാക്കുക"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सूचना बंद आहेत. सेटिंग्जमध्ये सुरू करा"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଜ୍ଞପ୍ତି ବନ୍ଦ ଅଛି। ସେଟିଂସରେ ଚାଲୁ କରନ୍ତୁ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਚਾਲੂ ਕਰੋ"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அறிவிப்புகள் முடக்கப்பட்டுள்ளன. அமைப்புகளில் இயக்கவும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నోటిఫికేషన్లు ఆఫ్‌లో ఉన్నాయి. సెట్టింగ్స్‌లో ఆన్ చేయండి"
          }
        }
