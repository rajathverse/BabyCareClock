    "Things you mark as done today will appear here." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজ যা হয়ে গেছে চিহ্নিত করবেন, তা এখানে দেখা যাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Things you mark as done today will appear here."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આજે થઈ ગયું તરીકે નિશાની કરેલું અહીં દેખાશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज जो हो गया मार्क करेंगे, वह यहाँ दिखेगा।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಂದು ಆಯಿತು ಎಂದು ಗುರುತಿಸಿದ್ದು ಇಲ್ಲಿ ಕಾಣುತ್ತದೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇന്ന് കഴിഞ്ഞതായി അടയാളപ്പെടുത്തുന്നവ ഇവിടെ കാണാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज झाले म्हणून खूण केलेले इथे दिसेल."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଜି ଯାହା ହୋଇଗଲା ବୋଲି ଚିହ୍ନିତ କରିବେ, ତାହା ଏଠାରେ ଦେଖାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਜ ਜੋ ਹੋ ਗਿਆ ਮਾਰਕ ਕਰੋਗੇ, ਉਹ ਇੱਥੇ ਦਿਖੇਗਾ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்று முடிந்தது எனக் குறிப்பவை இங்கே தோன்றும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈరోజు అయినట్లు గుర్తించినవి ఇక్కడ కనిపిస్తాయి."
          }
        }
      }
    },
    "This clears every vaccine and date you've recorded here." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে এখানে লেখা সব টিকা আর তারিখ মুছে যাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This clears every vaccine and date you've recorded here."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આથી અહીં નોંધેલી બધી રસીઓ અને તારીખો કાઢી નખાશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे यहाँ दर्ज सभी टीके और तारीखें हट जाएँगी।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಲ್ಲಿ ದಾಖಲಿಸಿದ ಎಲ್ಲಾ ಲಸಿಕೆಗಳು ಮತ್ತು ದಿನಾಂಕಗಳು ಅಳಿಸಲ್ಪಡುತ್ತವೆ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇവിടെ രേഖപ്പെടുത്തിയ എല്ലാ വാക്സിനുകളും തീയതികളും മായ്ക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे इथे नोंदवलेल्या सर्व लसी आणि तारखा काढल्या जातील."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଏଠାରେ ଲେଖାଥିବା ସମସ୍ତ ଟିକା ଓ ତାରିଖ ହଟାଇଦେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਨਾਲ ਇੱਥੇ ਦਰਜ ਸਾਰੇ ਟੀਕੇ ਅਤੇ ਤਰੀਕਾਂ ਹਟ ਜਾਣਗੀਆਂ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இங்கே பதிவுசெய்த எல்லா தடுப்பூசிகளும் தேதிகளும் நீக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇక్కడ నమోదు చేసిన అన్ని టీకాలు మరియు తేదీలు తొలగించబడతాయి."
          }
        }
      }
    },
    "This removes the baby profile, photo, care plan and all history from this iPhone, including the copy kept for reinstalling. It can't be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে শিশুর প্রোফাইল, ছবি, যত্নের পরিকল্পনা আর সব রেকর্ড এই iPhone থেকে মুছে যাবে, আবার ইনস্টলের জন্য রাখা কপিসহ। এটা আর ফেরানো যাবে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes the baby profile, photo, care plan and all history from this iPhone, including the copy kept for reinstalling. It can't be undone."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આથી બાળકની પ્રોફાઇલ, ફોટો, સંભાળ યોજના અને બધો રેકોર્ડ આ iPhone પરથી કાઢી નખાશે, ફરી ઇન્સ્ટોલ માટે રાખેલી નકલ સહિત. આ પાછું લાવી શકાશે નહીં."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे बच्चे की प्रोफ़ाइल, फ़ोटो, देखभाल योजना और सारा रिकॉर्ड इस iPhone से हट जाएगा, दोबारा इंस्टॉल के लिए रखी कॉपी भी। इसे वापस नहीं लाया जा सकता।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ಮಗುವಿನ ಪ್ರೊಫೈಲ್, ಫೋಟೋ, ಆರೈಕೆ ಯೋಜನೆ ಮತ್ತು ಎಲ್ಲಾ ದಾಖಲೆಯನ್ನು ಈ iPhone ನಿಂದ ಅಳಿಸುತ್ತದೆ, ಮರು ಇನ್‌ಸ್ಟಾಲ್‌ಗಾಗಿ ಇಟ್ಟ ಪ್ರತಿಯೂ ಸೇರಿ. ಇದನ್ನು ಹಿಂಪಡೆಯಲಾಗದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് കുഞ്ഞിന്റെ പ്രൊഫൈൽ, ഫോട്ടോ, പരിചരണ പദ്ധതി, എല്ലാ രേഖയും ഈ iPhone ൽ നിന്ന് നീക്കം ചെയ്യും, വീണ്ടും ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള പകർപ്പ് ഉൾപ്പെടെ. ഇത് തിരിച്ചെടുക്കാനാകില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे बाळाची माहिती, फोटो, काळजी योजना आणि सर्व नोंदी या iPhone वरून काढल्या जातील, पुन्हा इन्स्टॉलसाठी ठेवलेल्या प्रतीसह. हे परत आणता येणार नाही."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା ଶିଶୁର ପ୍ରୋଫାଇଲ, ଫଟୋ, ଯତ୍ନ ଯୋଜନା ଓ ସମସ୍ତ ରେକର୍ଡ ଏହି iPhone ରୁ ହଟାଇଦେବ, ପୁଣି ଇନଷ୍ଟଲ ପାଇଁ ରଖାଯାଇଥିବା କପି ସହିତ। ଏହାକୁ ଫେରାଇହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਨਾਲ ਬੱਚੇ ਦੀ ਪ੍ਰੋਫ਼ਾਈਲ, ਫ਼ੋਟੋ, ਦੇਖਭਾਲ ਯੋਜਨਾ ਅਤੇ ਸਾਰਾ ਰਿਕਾਰਡ ਇਸ iPhone ਤੋਂ ਹਟ ਜਾਵੇਗਾ, ਮੁੜ ਇੰਸਟਾਲ ਲਈ ਰੱਖੀ ਕਾਪੀ ਸਮੇਤ। ਇਸਨੂੰ ਵਾਪਸ ਨਹੀਂ ਲਿਆਂਦਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது குழந்தையின் விவரம், புகைப்படம், பராமரிப்புத் திட்டம் மற்றும் எல்லா பதிவையும் இந்த iPhone இலிருந்து நீக்கும், மீண்டும் நிறுவுவதற்கான நகல் உட்பட. இதைத் திரும்பப் பெற முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది బిడ్డ ప్రొఫైల్, ఫోటో, సంరక్షణ ప్రణాళిక మరియు మొత్తం రికార్డును ఈ iPhone నుండి తొలగిస్తుంది, మళ్లీ ఇన్‌స్టాల్ కోసం ఉంచిన కాపీతో సహా. దీన్ని రద్దు చేయలేము."
          }
        }
      }
    },
