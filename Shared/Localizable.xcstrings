          "stringUnit" : {
            "state" : "translated",
            "value" : "ਪਹਿਲਾਂ ਵਾਲਾ ਡਾਟਾ ਬਾਅਦ ਵਿੱਚ ਵਾਪਸ ਨਹੀਂ ਆ ਸਕੇਗਾ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முந்தைய தரவை பிறகு மீட்டெடுக்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ముందటి డేటాను తర్వాత తిరిగి తేలేము."
          }
        }
      }
    },
    "The next due time for %@ will be recalculated." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ এর পরের সময় আবার হিসাব করা হবে।"
