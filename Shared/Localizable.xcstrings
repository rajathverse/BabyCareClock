    "%@'s %@ vaccines are due on %@. Time to book the visit." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@-র %2$@ এর টিকা %3$@ তারিখে। ডাক্তারের সময় নিয়ে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@'s %@ vaccines are due on %@. Time to book the visit."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ની %2$@ ની રસીઓ %3$@ ના રોજ છે. મુલાકાત નક્કી કરી લો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ के %2$@ वाले टीके %3$@ को लगने हैं। डॉक्टर से समय ले लें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಅವರ %2$@ ಲಸಿಕೆಗಳು %3$@ ರಂದು ಇವೆ. ಭೇಟಿಯನ್ನು ಬುಕ್ ಮಾಡುವ ಸಮಯ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ന്റെ %2$@ വാക്സിനുകൾ %3$@ ന് ആണ്. സന്ദർശനം ബുക്ക് ചെയ്യാനുള്ള സമയം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ च्या %2$@ च्या लसी %3$@ रोजी आहेत. भेटीची वेळ ठरवा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ର %2$@ ର ଟିକା %3$@ ରେ ଅଛି। ଡାକ୍ତରଙ୍କ ସମୟ ନେଇନିଅନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ਦੇ %2$@ ਵਾਲੇ ਟੀਕੇ %3$@ ਨੂੰ ਹਨ। ਡਾਕਟਰ ਤੋਂ ਸਮਾਂ ਲੈ ਲਓ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ இன் %2$@ தடுப்பூசிகள் %3$@ அன்று. வருகையை முன்பதிவு செய்யும் நேரம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ టీకాలు %3$@ న ఉన్నాయి. అపాయింట్‌మెంట్ తీసుకునే సమయం."
          }
        }
      }
    },
    "%@'s %@ vaccines are due today (%@)." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
