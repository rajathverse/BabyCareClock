        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ, ಅಥವಾ ನಿಮ್ಮದೇ ಮಾಡಿ"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒന്ന് തിരഞ്ഞെടുക്കുക, അല്ലെങ്കിൽ സ്വന്തമായി ഉണ്ടാക്കുക"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक निवडा, किंवा स्वतःचे बनवा"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗୋଟିଏ ବାଛନ୍ତୁ, କିମ୍ବା ନିଜର ତିଆରି କରନ୍ତୁ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੋਈ ਚੁਣੋ, ਜਾਂ ਆਪਣਾ ਬਣਾਓ"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒன்றைத் தேர்வுசெய்யுங்கள், அல்லது உங்களுடையதை உருவாக்குங்கள்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒకటి ఎంచుకోండి, లేదా మీ సొంతది చేయండి"
          }
        }
      }
    },
    "Pick what you need. Tap the timing to change it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যা দরকার বেছে নিন। সময় বদলাতে সেখানে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick what you need. Tap the timing to change it."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમને જે જોઈએ તે પસંદ કરો. સમય બદલવા તેના પર ટેપ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो ज़रूरी हो वह चुनें। समय बदलने के लिए उस पर टैप करें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ಬೇಕಾದ್ದನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಸಮಯ ಬದಲಿಸಲು ಅದರ ಮೇಲೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾക്ക് വേണ്ടത് തിരഞ്ഞെടുക്കുക. സമയം മാറ്റാൻ അതിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला हवे ते निवडा. वेळ बदलण्यासाठी त्यावर टॅप करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାହା ଦରକାର ବାଛନ୍ତୁ। ସମୟ ବଦଳାଇବାକୁ ସେଥିରେ ଟାପ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੋ ਚਾਹੀਦਾ ਹੈ ਉਹ ਚੁਣੋ। ਸਮਾਂ ਬਦਲਣ ਲਈ ਉਸ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுக்குத் தேவையானதைத் தேர்வுசெய்யுங்கள். நேரத்தை மாற்ற அதைத் தட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు కావాల్సినవి ఎంచుకోండి. సమయం మార్చడానికి దానిపై నొక్కండి."
          }
        }
      }
