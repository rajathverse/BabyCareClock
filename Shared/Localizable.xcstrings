        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ இன் அடுத்த நேரம் மீண்டும் கணக்கிடப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ తర్వాతి సమయం మళ్లీ లెక్కించబడుతుంది."
          }
        }
      }
    },
    "The next one is due this long after the last time it was done." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষবার হওয়ার এতক্ষণ পরে পরেরটা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The next one is due this long after the last time it was done."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "છેલ્લે થયા પછી આટલા સમયે આગળનું."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली बार के बाद इतने समय में अगली बार होगा।"
