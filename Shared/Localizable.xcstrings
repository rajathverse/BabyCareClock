        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ന്റെ അടുത്ത സമയം വീണ്ടും കണക്കാക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
