            "value" : "Logged %@. The next dose is OK after %@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ની નોંધ થઈ. આગળનો ડોઝ %2$@ પછી આપી શકાય."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ दर्ज किया। अगली खुराक %2$@ के बाद दे सकते हैं।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ದಾಖಲಿಸಲಾಗಿದೆ. ಮುಂದಿನ ಡೋಸ್ %2$@ ನಂತರ ಕೊಡಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ രേഖപ്പെടുത്തി. അടുത്ത ഡോസ് %2$@ ന് ശേഷം നൽകാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ची नोंद केली. पुढचा डोस %2$@ नंतर देता येईल."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ଲେଖାଗଲା। ପରବର୍ତ୍ତୀ ଡୋଜ୍ %2$@ ପରେ ଦେଇହେବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ਦਰਜ ਕੀਤਾ। ਅਗਲੀ ਖ਼ੁਰਾਕ %2$@ ਤੋਂ ਬਾਅਦ ਦੇ ਸਕਦੇ ਹੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ பதிவுசெய்யப்பட்டது. அடுத்த அளவை %2$@ க்குப் பிறகு கொடுக்கலாம்."
