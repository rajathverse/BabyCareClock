    "Pick a few to start. You can change times and add your own later." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুরুতে কয়েকটি বেছে নিন। সময় পরে বদলানো যাবে, নিজের জিনিসও যোগ করা যাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a few to start. You can change times and add your own later."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શરૂઆત માટે થોડું પસંદ કરો. સમય પછી બદલી શકાય અને તમારી પોતાની વસ્તુઓ પણ ઉમેરી શકાય."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरुआत के लिए कुछ चुनें। समय बाद में बदल सकते हैं और अपनी चीज़ें भी जोड़ सकते हैं।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಶುರುವಿಗೆ ಕೆಲವನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಸಮಯವನ್ನು ನಂತರ ಬದಲಿಸಬಹುದು ಮತ್ತು ನಿಮ್ಮದೇ ಐಟಂಗಳನ್ನು ಸೇರಿಸಬಹುದು."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "തുടങ്ങാൻ കുറച്ചെണ്ണം തിരഞ്ഞെടുക്കുക. സമയങ്ങൾ പിന്നീട് മാറ്റാം, സ്വന്തമായവയും ചേർക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुरुवातीला काही निवडा. वेळा नंतर बदलता येतील आणि स्वतःच्या गोष्टीही जोडता येतील."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆରମ୍ଭ ପାଇଁ କିଛି ବାଛନ୍ତୁ। ସମୟ ପରେ ବଦଳାଇପାରିବେ ଏବଂ ନିଜ ଜିନିଷ ମଧ୍ୟ ଯୋଡ଼ିପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸ਼ੁਰੂਆਤ ਲਈ ਕੁਝ ਚੁਣੋ। ਸਮਾਂ ਬਾਅਦ ਵਿੱਚ ਬਦਲ ਸਕਦੇ ਹੋ ਅਤੇ ਆਪਣੀਆਂ ਚੀਜ਼ਾਂ ਵੀ ਜੋੜ ਸਕਦੇ ਹੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடங்க சிலவற்றைத் தேர்வுசெய்யுங்கள். நேரங்களைப் பிறகு மாற்றலாம், உங்களுடையதையும் சேர்க்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మొదట కొన్ని ఎంచుకోండి. సమయాలను తర్వాత మార్చవచ్చు, మీ సొంతవి కూడా జోడించవచ్చు."
          }
        }
      }
    },
    "Pick one, or make your own" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি বেছে নিন, বা নিজের বানান"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one, or make your own"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક પસંદ કરો, અથવા તમારું પોતાનું બનાવો"
          }
