    "Tap any item to change its name, times or dosage." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নাম, সময় বা ডোজ বদলাতে যেকোনো জিনিসে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any item to change its name, times or dosage."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નામ, સમય કે ડોઝ બદલવા કોઈપણ વસ્તુ પર ટેપ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम, समय या खुराक बदलने के लिए किसी भी चीज़ पर टैप करें।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೆಸರು, ಸಮಯ ಅಥವಾ ಡೋಸ್ ಬದಲಿಸಲು ಯಾವುದೇ ಐಟಂ ಮೇಲೆ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പേര്, സമയങ്ങൾ അല്ലെങ്കിൽ ഡോസ് മാറ്റാൻ ഏതെങ്കിലും ഇനത്തിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाव, वेळा किंवा डोस बदलण्यासाठी कोणत्याही गोष्टीवर टॅप करा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନାମ, ସମୟ କିମ୍ବା ଡୋଜ୍ ବଦଳାଇବାକୁ ଯେକୌଣସି ଜିନିଷ ଉପରେ ଟାପ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨਾਮ, ਸਮਾਂ ਜਾਂ ਖ਼ੁਰਾਕ ਬਦਲਣ ਲਈ ਕਿਸੇ ਵੀ ਚੀਜ਼ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெயர், நேரம் அல்லது அளவை மாற்ற எதையும் தட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పేరు, సమయాలు లేదా మోతాదు మార్చడానికి ఏదైనా అంశంపై నొక్కండి."
          }
        }
      }
    },
