        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഓർമ്മപ്പെടുത്തൽ വേണ്ട പാൽ, ഉറക്കം, വിറ്റാമിനുകൾ, മരുന്നുകൾ എന്നിവ ചേർക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज्यांची आठवण हवी ते दूध, झोप, व्हिटॅमिन आणि औषधे जोडा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯାହା ପାଇଁ ସ୍ମାରକ ଦରକାର ସେହି କ୍ଷୀର, ନିଦ, ଭିଟାମିନ ଓ ଔଷଧ ଯୋଡ଼ନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਿਨ੍ਹਾਂ ਲਈ ਯਾਦ-ਦਹਾਨੀ ਚਾਹੀਦੀ ਹੈ ਉਹ ਦੁੱਧ, ਨੀਂਦ, ਵਿਟਾਮਿਨ ਅਤੇ ਦਵਾਈਆਂ ਜੋੜੋ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நினைவூட்டல் வேண்டிய பால், தூக்கம், வைட்டமின் மற்றும் மருந்துகளைச் சேர்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు రిమైండర్ కావాల్సిన పాలు, నిద్ర, విటమిన్లు మరియు మందులు జోడించండి."
          }
        }
      }
    },
