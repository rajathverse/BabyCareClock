        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଡାକ୍ତରଙ୍କୁ ଦେଖାଇବା ପାଇଁ ସ୍ପଷ୍ଟ ରେକର୍ଡ"
