          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଫଟୋ ଯୋଡ଼ନ୍ତୁ, ଏହା ଆପରେ ଏବଂ ହୋମ ସ୍କ୍ରିନ ୱିଜେଟରେ ଦେଖାଯିବ।"
