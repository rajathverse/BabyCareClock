    "It was due at %@. Tap Done once it's given." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা %@ এ দেওয়ার কথা ছিল। দেওয়ার পর হয়ে গেছে চাপুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was due at %@. Tap Done once it's given."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ %@ વાગ્યે આપવાનું હતું. આપ્યા પછી થઈ ગયું દબાવો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह %@ बजे देना था। देने के बाद हो गया दबाएँ।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು %@ ಕ್ಕೆ ಇತ್ತು. ಕೊಟ್ಟ ನಂತರ ಆಯಿತು ಒತ್ತಿ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് %@ ന് ആയിരുന്നു. നൽകിയ ശേഷം കഴിഞ്ഞു അമർത്തുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे %@ वाजता द्यायचे होते. दिल्यावर झाले दाबा."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା %@ ରେ ଦେବାର ଥିଲା। ଦେବା ପରେ ହୋଇଗଲା ଦବାନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ %@ ਵਜੇ ਦੇਣਾ ਸੀ। ਦੇਣ ਤੋਂ ਬਾਅਦ ਹੋ ਗਿਆ ਦਬਾਓ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது %@ மணிக்கு இருந்தது. கொடுத்த பிறகு முடிந்தது தட்டவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది %@ కి ఉంది. ఇచ్చిన తర్వాత అయింది నొక్కండి."
          }
        }
      }
    },
