    "One tap to log it, even half asleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক ট্যাপে লিখে রাখুন, আধো ঘুমেও"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One tap to log it, even half asleep"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક ટેપમાં નોંધ, અડધી ઊંઘમાં પણ"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक टैप में दर्ज करें, आधी नींद में भी"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದೇ ಟ್ಯಾಪ್‌ನಲ್ಲಿ ದಾಖಲಿಸಿ, ಅರೆ ನಿದ್ದೆಯಲ್ಲೂ"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒറ്റ ടാപ്പിൽ രേഖപ്പെടുത്താം, പാതി ഉറക്കത്തിലും"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एका टॅपमध्ये नोंद, अर्धवट झोपेतही"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗୋଟିଏ ଟାପରେ ଲେଖନ୍ତୁ, ଅଧା ନିଦରେ ବି"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਟੈਪ ਵਿੱਚ ਦਰਜ ਕਰੋ, ਅੱਧੀ ਨੀਂਦ ਵਿੱਚ ਵੀ"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரே தட்டலில் பதிவு, அரைத் தூக்கத்திலும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక్క నొక్కుతో నమోదు, సగం నిద్రలో కూడా"
          }
        }
      }
    },
    "Only a vibration when you tap Done or Snooze. Reminder notifications are not affected." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হয়ে গেছে বা পিছিয়ে দিন চাপলে শুধু ভাইব্রেশন। রিমাইন্ডার নোটিফিকেশনে প্রভাব পড়ে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only a vibration when you tap Done or Snooze. Reminder notifications are not affected."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "થઈ ગયું અથવા સ્નૂઝ દબાવો ત્યારે ફક્ત વાઇબ્રેશન. રિમાઇન્ડર સૂચનાઓ પર અસર થતી નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हो गया या स्नूज़ दबाने पर सिर्फ़ वाइब्रेशन। रिमाइंडर नोटिफ़िकेशन पर इसका असर नहीं होता।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆಯಿತು ಅಥವಾ ಸ್ನೂಜ್ ಒತ್ತಿದಾಗ ಕೇವಲ ಕಂಪನ. ಜ್ಞಾಪನೆ ಅಧಿಸೂಚನೆಗಳ ಮೇಲೆ ಪರಿಣಾಮವಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "കഴിഞ്ഞു അല്ലെങ്കിൽ മാറ്റിവയ്ക്കുക അമർത്തുമ്പോൾ വൈബ്രേഷൻ മാത്രം. ഓർമ്മപ്പെടുത്തൽ അറിയിപ്പുകളെ ബാധിക്കില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "झाले किंवा पुढे ढकला दाबल्यावर फक्त कंपन. आठवण सूचनांवर परिणाम होत नाही."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ହୋଇଗଲା କିମ୍ବା ସ୍ନୁଜ୍ ଦବାଇଲେ କେବଳ କମ୍ପନ। ସ୍ମାରକ ବିଜ୍ଞପ୍ତି ଉପରେ ପ୍ରଭାବ ପଡ଼େ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੋ ਗਿਆ ਜਾਂ ਸਨੂਜ਼ ਦਬਾਉਣ 'ਤੇ ਸਿਰਫ਼ ਵਾਈਬ੍ਰੇਸ਼ਨ। ਯਾਦ-ਦਹਾਨੀ ਸੂਚਨਾਵਾਂ 'ਤੇ ਕੋਈ ਅਸਰ ਨਹੀਂ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "முடிந்தது அல்லது ஒத்திவை அழுத்தும்போது அதிர்வு மட்டும். நினைவூட்டல் அறிவிப்புகள் பாதிக்கப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అయింది లేదా వాయిదా నొక్కినప్పుడు వైబ్రేషన్ మాత్రమే. రిమైండర్ నోటిఫికేషన్లపై ప్రభావం ఉండదు."
          }
        }
      }
    },
    "Only stored on this iPhone. Never uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু এই iPhone এ থাকে। কখনও আপলোড হয় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only stored on this iPhone. Never uploaded."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત આ iPhone પર રહે છે. ક્યારેય અપલોડ થતું નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ इसी iPhone पर रहता है। कभी अपलोड नहीं होता।"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ iPhone ನಲ್ಲಿ ಮಾತ್ರ ಇರುತ್ತದೆ. ಎಂದಿಗೂ ಅಪ್‌ಲೋಡ್ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ iPhone ൽ മാത്രം സൂക്ഷിക്കുന്നു. ഒരിക്കലും അപ്‌ലോഡ് ചെയ്യില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त या iPhone वर राहते. कधीही अपलोड होत नाही."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ ଏହି iPhone ରେ ରହେ। କେବେ ଅପଲୋଡ ହୁଏ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਿਰਫ਼ ਇਸ iPhone 'ਤੇ ਰਹਿੰਦਾ ਹੈ। ਕਦੇ ਅੱਪਲੋਡ ਨਹੀਂ ਹੁੰਦਾ।"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த iPhone இல் மட்டுமே சேமிக்கப்படும். ஒருபோதும் பதிவேற்றப்படாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ iPhone లో మాత్రమే ఉంటుంది. ఎప్పుడూ అప్‌లోడ్ అవ్వదు."
          }
        }
      }
    },
    "Open Baby Care Clock on your iPhone to get started." : {
